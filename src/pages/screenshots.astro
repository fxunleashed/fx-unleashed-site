---
import Base from "../layouts/Base.astro";
import { site } from "../config";
// The plugin's own tabs as they look in SimHub. The pictures are in public/screenshots/ (WebP, full size).
const shots = [
  { file: "wheel", w: 1382, h: 1298, title: "Wheel", alt: "The Wheel tab: a drawing of the FX Pro showing its lights and dash live, the wheel's status, and the dash button and paddle settings.",
    text: "Your wheel, live: the lights and dash as they are on the real one, its status, the screen's memory, and which button is the dash button and the upper paddles.",
    more: { href: "/start/", label: "Get started" } },
  { file: "dashes", w: 1351, h: 1293, title: "Dashes", alt: "The Dashes tab: the dashes on the screen for the default list, buttons to switch and demo them, and the library of dashes below.",
    text: "The dashes on the screen, for each car or for all of them. Switch with the dash button, try one on the wheel, copy it into the screen's RAM, edit it in the designer, share it or package it for the library.",
    more: { href: "/docs/dash-designer/", label: "The dash designer" } },
  { file: "lights", w: 1298, h: 1302, title: "Lights", alt: "The Lights tab: where the lights come from (FX Unleashed, ATSR-Hub or a SimHub device), a preview of the Full Rainbow preset on the wheel, and the preset list.",
    text: "All 38 lights. Pick where they come from (our presets, ATSR-Hub or a SimHub device), preview a preset on the wheel in every situation, and edit alerts and colours per group.",
    more: { href: "/docs/lights/", label: "Lights in SimHub and ATSR-Hub" } },
  { file: "idle", w: 1334, h: 1301, title: "Idle & sleep", alt: "The Idle and sleep tab: screensavers between sessions (logo, clock, start lights, tacho sweep, pit board, chequered flag) and the screensaver library.",
    text: "What the screen shows between sessions: the logo, a clock, the start lights, a sweeping tacho, a pit board of your last session, or your own picture or dash. The community screensaver library is right below.",
    more: { href: "/library/", label: "The library" } },
];
---
<Base title="Screenshots" description="What the FX Unleashed plugin looks like in SimHub: the Wheel, Dashes, Lights and Idle and sleep tabs.">
  <section class="wrap page">
    <p class="eyebrow">Screenshots</p>
    <h1>The plugin, <span class="red">in SimHub</span></h1>
    <p class="lead">Four of its tabs, as they look while the wheel is connected in Unleashed mode. Click a picture to see it full size.</p>

    <div class="shots">
      {shots.map((s, i) => (
        <figure class="shot reveal">
          <button class="zoom" type="button" data-src={`/screenshots/${s.file}.webp`} data-alt={s.alt} aria-label={`Enlarge: ${s.title}`}>
            <img src={`/screenshots/${s.file}.webp`} alt={s.alt} width={s.w} height={s.h} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
          </button>
          <figcaption>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
            <p class="more"><a href={s.more.href}>{s.more.label} →</a></p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="cta card reveal">
      <h3>Want to try it?</h3>
      <p>It's free. Three steps, about 15 minutes, and every step says what you should see.</p>
      <p class="actions"><a class="btn primary" href="/start/">Get started</a><a class="btn" href="/library/">Browse the library</a><a class="btn" href={site.discord} target="_blank" rel="noopener">Join the Discord</a></p>
    </div>
  </section>

  <dialog id="viewer" aria-label="Screenshot"><button type="button" class="close" aria-label="Close">×</button><img alt="" /></dialog>
</Base>
<style>
  .page { padding: 150px 0 100px; position: relative; z-index: 1; }
  .shots { display: grid; gap: 70px; margin-top: 50px; }
  .shot { margin: 0; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); gap: 36px; align-items: start; }
  .shot:nth-child(even) { grid-template-columns: minmax(260px, 1fr) minmax(0, 1.55fr); }
  .shot:nth-child(even) .zoom { order: 2; }
  .zoom { display: block; padding: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: #0b0c0f; cursor: zoom-in; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .zoom:hover { border-color: var(--red); transform: translateY(-3px); box-shadow: 0 20px 60px -20px var(--red-glow); }
  .zoom img { display: block; width: 100%; height: auto; }
  figcaption { padding-top: 6px; }
  figcaption h2 { margin: 0 0 12px; font-size: clamp(26px, 3vw, 38px); text-transform: none; }
  figcaption p { color: var(--text-2); font-size: 16px; line-height: 1.6; }
  .more a { color: var(--red-2); border-bottom: 1px solid rgba(255, 90, 100, 0.35); }
  .more a:hover { color: #fff; border-color: #fff; }
  .cta { margin-top: 90px; text-align: center; padding: 40px 28px; }
  .cta h3 { margin-bottom: 8px; }
  .cta .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
  dialog#viewer { border: 1px solid var(--line); border-radius: 16px; padding: 0; background: #0b0c0f; max-width: min(96vw, 1500px); max-height: 94vh; overflow: auto; }
  dialog#viewer::backdrop { background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(4px); }
  dialog#viewer img { display: block; width: 100%; height: auto; }
  dialog#viewer .close { position: fixed; top: 14px; right: 18px; z-index: 2; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line-2); background: rgba(10, 11, 14, 0.9); color: #fff; font-size: 26px; line-height: 1; cursor: pointer; }
  @media (max-width: 900px) {
    .shot, .shot:nth-child(even) { grid-template-columns: 1fr; gap: 18px; }
    .shot:nth-child(even) .zoom { order: 0; }
    .shots { gap: 50px; }
  }
</style>
<script>
  // click a picture: full size in a dialog (Esc, the button or a click outside closes it)
  const dlg = document.getElementById("viewer") as HTMLDialogElement;
  const big = dlg.querySelector("img") as HTMLImageElement;
  document.querySelectorAll<HTMLButtonElement>(".zoom").forEach(b => b.addEventListener("click", () => {
    big.src = b.dataset.src!; big.alt = b.dataset.alt ?? "";
    dlg.showModal();
  }));
  dlg.querySelector(".close")!.addEventListener("click", () => dlg.close());
  dlg.addEventListener("click", e => { if (e.target === dlg) dlg.close(); });
</script>
