---
import Base from "../layouts/Base.astro";
import DocPage from "../components/DocPage.astro";
import { render, docs, byName } from "../lib/md";
// The guide is docs/setup.md in the plugin repo (npm run sync copies it): edit it there.
const md = byName(docs, "setup.md").replace(/^﻿?\s*# [^\n]*\n/, "").replace(/^Three steps:[\s\S]*?\n\n/m, ""); // the lead above says it already
const { html, toc } = render(md);
---
<Base title="Get started" description="Three steps to your own dashes and lights on the Simagic FX Pro: the custom firmware, the plugin, and picture memory for the screen.">
  <DocPage html={html} toc={toc}>
    <Fragment slot="before">
      <h1>Get started</h1>
      <p class="lead">One guide, start to finish: the custom firmware, the plugin, and (optional, but highly recommended) picture memory, the screen's RAM patch. Every step says what you should see. Curious first? <a href="/screenshots/">See the screenshots</a>.</p>
      <div class="quick">
        <a class="q" href="#1-install-the-custom-firmware"><b>1</b><span>Custom firmware<small>~10 min</small></span></a>
        <a class="q" href="#2-install-the-plugin"><b>2</b><span>Plugin<small>~2 min</small></span></a>
        <a class="q hl" href="#3-turn-on-picture-memory"><b>3</b><span>Picture memory (RAM patch)<small>Optional · highly recommended</small></span></a>
        <a class="q" href="#4-pick-your-dashes-and-lights"><b>4</b><span>Dashes and lights<small>Make it yours</small></span></a>
      </div>
    </Fragment>
  </DocPage>
</Base>
<script src="../scripts/firmware.ts"></script>
<style>
  .quick { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 30px 0 40px; }
  .q { display: flex; gap: 12px; align-items: center; padding: 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--panel-solid); border-bottom: 1px solid var(--line) !important; transition: border-color 0.2s, transform 0.2s; }
  .q:hover { border-color: var(--red) !important; transform: translateY(-2px); }
  .q b { font: 700 28px/1 var(--display); color: var(--red); }
  .q span { font: 600 14px/1.2 var(--display); color: #fff; letter-spacing: 0.04em; }
  .q small { display: block; margin-top: 4px; font: 500 11px/1.3 var(--body, inherit); color: var(--text-3); letter-spacing: 0.02em; }
  .q.hl { border-color: rgba(255, 31, 45, 0.5); background: linear-gradient(180deg, rgba(255,31,45,0.08), var(--panel-solid)); }
  .q.hl small { color: var(--red); }
</style>
