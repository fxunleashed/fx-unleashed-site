---
import Base from "../layouts/Base.astro";
import { FAQ } from "../data/faq";
import { site } from "../config";
const link = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
const tags = [...new Set(FAQ.map(f => f.tag ?? "Other"))];
const schema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: FAQ.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.replace(/\*\*/g, "").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") } })) };
---
<Base title="FAQ" description="Questions about FX Unleashed, answered short.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <section class="wrap page">
    <p class="eyebrow">FAQ</p>
    <h1>Questions, <span class="red">answered</span></h1>
    {tags.map(t => (
      <div class="group">
        <h2>{t}</h2>
        {FAQ.filter(f => (f.tag ?? "Other") === t).map(f => (
          <details class="qa">
            <summary>{f.q}</summary>
            <p set:html={link(f.a)} />
          </details>
        ))}
      </div>
    ))}
    <p class="more">Not here? <a href={site.contact} class="red">Ask on GitHub →</a></p>
  </section>
</Base>
<style>
  .page { padding: 150px 0 100px; position: relative; z-index: 1; max-width: 900px; }
  .group { margin-top: 50px; }
  .group h2 { font-size: 16px; letter-spacing: 0.24em; color: var(--red-2); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font: 600 19px/1.3 var(--display); position: relative; }
  .qa summary::after { content: "+"; position: absolute; right: 6px; top: 18px; font-size: 26px; color: var(--red); transition: transform 0.3s; }
  .qa[open] summary::after { transform: rotate(45deg); }
  .qa p { padding-bottom: 20px; margin: 0; }
  .qa p :global(a) { color: var(--red-2); border-bottom: 1px solid rgba(255,90,100,0.35); }
  .more { margin-top: 50px; }
</style>
