---
import { nav, site } from "../config";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, "")));
---
<header class="nav">
  <div class="nav-in">
    <a href="/" class="brand" aria-label={site.name + " home"}>
      <img src="/brand/mark-512.png" alt="" width="38" height="38" />
      <span><b>FX</b> UNLEASHED</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.filter(n => n.href !== "/").map(n => (
          <li><a href={n.href} aria-current={active(n.href) ? "page" : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn primary small cta" href="/start/">Get it free</a>
    <button class="menu" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
  </div>
</header>
<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 14px var(--gutter); transition: background 0.3s, backdrop-filter 0.3s; }
  .nav.solid { background: rgba(5, 6, 8, 0.72); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
  .nav-in { max-width: var(--max); margin: 0 auto; display: flex; align-items: center; gap: 28px; }
  .brand { display: flex; align-items: center; gap: 12px; font: 700 18px/1 var(--display); letter-spacing: 0.08em; }
  .brand img { filter: drop-shadow(0 0 10px var(--red-glow)); }
  .brand b { color: var(--red); }
  nav { margin-left: auto; }
  ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  ul a { display: block; padding: 8px 12px; border-radius: 999px; font: 600 13px/1 var(--display); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-2); transition: color 0.2s, background 0.2s; }
  ul a:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
  ul a[aria-current="page"] { color: #fff; box-shadow: inset 0 -2px 0 var(--red); border-radius: 0; }
  .menu { display: none; margin-left: auto; width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--line-2); background: rgba(255,255,255,0.04); flex-direction: column; gap: 6px; align-items: center; justify-content: center; cursor: pointer; }
  .menu span { width: 18px; height: 2px; background: #fff; transition: transform 0.3s; }
  @media (max-width: 1080px) {
    nav { position: fixed; inset: 64px 12px auto 12px; display: none; background: rgba(10, 11, 14, 0.96); border: 1px solid var(--line); border-radius: 18px; padding: 10px; }
    nav.open { display: block; }
    ul { flex-direction: column; }
    ul a { padding: 14px; font-size: 15px; }
    .menu { display: flex; }
    .cta { display: none; }
  }
</style>
<script>
  const header = document.querySelector(".nav")!;
  const onScroll = () => header.classList.toggle("solid", scrollY > 30);
  addEventListener("scroll", onScroll, { passive: true }); onScroll();
  const btn = document.querySelector(".menu") as HTMLButtonElement, nav = document.querySelector("header nav")!;
  btn.addEventListener("click", () => { const o = nav.classList.toggle("open"); btn.setAttribute("aria-expanded", String(o)); });
</script>
