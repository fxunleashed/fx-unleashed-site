---
// Where a page sits in the whole path: the four things a newcomer does, each linking to its step in the guide.
// Pages that explain one part of the process (the wheel app, the library, the guide itself) show this so nobody
// has to guess what comes before or after.
interface Props { current?: 1 | 2 | 3 | 4; title?: string }
const { current, title = "The whole path" } = Astro.props;
const steps = [
  { n: 1, title: "Wheel app", note: "~10 min · for Unleashed mode", href: "/start/#1-install-the-wheel-app" },
  { n: 2, title: "Plugin", note: "~2 min", href: "/start/#2-install-the-plugin" },
  { n: 3, title: "Picture memory (RAM patch)", note: "Optional · highly recommended", href: "/start/#3-turn-on-picture-memory", hl: true },
  { n: 4, title: "Dashes and lights", note: "Make it yours", href: "/start/#4-pick-your-dashes-and-lights" },
];
---
<nav class="path" aria-label="Setup path">
  <p class="eyebrow">{title}</p>
  <div class="steps">
    {steps.map(s => (
      <a class={`q${s.hl ? " hl" : ""}${current === s.n ? " here" : ""}`} href={s.href} aria-current={current === s.n ? "step" : undefined}>
        <b>{s.n}</b>
        <span>{s.title}<small>{current === s.n ? "You are here" : s.note}</small></span>
      </a>
    ))}
  </div>
  <p class="all"><a href="/start/">Open the full guide</a> · <a href="/faq/">FAQ</a> · <a href="/library/">Library</a></p>
</nav>
<style>
  .path { margin: 30px 0 40px; }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-top: 12px; }
  .q { display: flex; gap: 12px; align-items: center; padding: 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--panel-solid); border-bottom: 1px solid var(--line) !important; transition: border-color 0.2s, transform 0.2s; }
  .q:hover { border-color: var(--red) !important; transform: translateY(-2px); }
  .q b { font: 700 28px/1 var(--display); color: var(--red); }
  .q span { font: 600 14px/1.2 var(--display); color: #fff; letter-spacing: 0.04em; }
  .q small { display: block; margin-top: 4px; font: 500 11px/1.3 var(--body, inherit); color: var(--text-3); letter-spacing: 0.02em; }
  .q.hl { border-color: rgba(255, 31, 45, 0.5); background: linear-gradient(180deg, rgba(255,31,45,0.08), var(--panel-solid)); }
  .q.hl small { color: var(--red); }
  .q.here { border-color: var(--red) !important; box-shadow: 0 0 24px -8px var(--red-glow); }
  .q.here small { color: var(--red); font-weight: 700; }
  .all { margin: 12px 0 0; font-size: 13.5px; color: var(--text-3); }
  .all a { color: var(--red-2); border-bottom: 1px solid rgba(255, 90, 100, 0.35); }
</style>
